{
  "name": "grecia-mejia-weddings",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "seed:nav": "tsx --env-file=.env.local src/sanity/seed/navigation.ts",
    "seed:footer": "tsx --env-file=.env.local src/sanity/seed/footer.ts",
    "seed:settings": "tsx --env-file=.env.local src/sanity/seed/siteSettings.ts",
    "seed:home": "tsx --env-file=.env.local src/sanity/seed/homePage.ts",
    "seed:home-media": "tsx --env-file=.env.local src/sanity/seed/homePageMedia.ts",
    "seed:destinations": "tsx --env-file=.env.local src/sanity/seed/destinationsPage.ts",
    "migrate:cleanup-site-settings": "tsx --env-file=.env.local src/sanity/migrations/cleanupSiteSettings.ts"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^7.22.0",
    "@sanity/document-internationalization": "^6.1.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.25.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "next-sanity": "^12.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^5.25.1",
    "sanity-plugin-media": "^4.3.0",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prettier": "3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.0",
    "typescript": "^5"
  }
}
